module alchitry_top (
    input clk,              // 100MHz clock
    input rst_n,            // reset button (active low)
    output led[8],          // 8 user controllable LEDs
    input usb_rx,           // USB->Serial input
    output usb_tx,          // USB->Serial output
    output io_led[3][8],    // LEDs on IO Shield
    output io_segment[8],   // 7-segment LEDs on IO Shield
    output io_select[4],    // Digit select on IO Shield
    input io_button[5],     // 5 buttons on IO Shield
    input io_dip[3][8]      // DIP switches on IO Shield
) {
    // reset signal
    sig rst
    // clock frequency, put 1000 for sim, 100M for hardware 
    const CLK_FREQ = $is_sim() ? 1000 : 100000000 
    // clock div for seven segment display, put 3 for sim, 16 for hardware
    const SEVEN_SEG_DIV = $is_sim() ? 3 : 16
    // clock div for 0.5s, put 9 for sim, 25 for hardware
    const SLOW_CLOCK_DIV = $is_sim() ? 9 : 25
    // clock div for 1s, put 10 for sim, 26 for hardware
    const SLOWER_CLOCK_DIV = $is_sim() ? 10 : 26
    // clock div for 2s, put 11 for sim, 27 for hardware 
    const SLOWEST_CLOCK_DIV = $is_sim() ? 11 : 27
    
    .clk(clk) {
        // The reset conditioner is used to synchronize the reset signal to the FPGA
        // clock. This ensures the entire FPGA comes out of reset at the same time.
        reset_conditioner reset_cond
        // edge detectors for buttons p1, p2, p3, p4
        edge_detector edge_dt_btn_p1(#RISE(1), #FALL(0))
        edge_detector edge_dt_btn_p2(#RISE(1), #FALL(0))
        edge_detector edge_dt_btn_p3(#RISE(1), #FALL(0))
        edge_detector edge_dt_btn_p4(#RISE(1), #FALL(0))
        // button conditioners for buttons p1, p2, p3, p4
        button_conditioner btn_cond_p1(#CLK_FREQ(CLK_FREQ))
        button_conditioner btn_cond_p2(#CLK_FREQ(CLK_FREQ)) 
        button_conditioner btn_cond_p3(#CLK_FREQ(CLK_FREQ)) 
        button_conditioner btn_cond_p4(#CLK_FREQ(CLK_FREQ)) 
        .rst(rst){
            // instantiation of multi_seven_seg module
            multi_seven_seg seg(#DIV(SEVEN_SEG_DIV))
            // instantiation of game_datapath module
            game_datapath game_datapath(#SLOW_CLOCK_DIV(SLOW_CLOCK_DIV), 
                #SLOWER_CLOCK_DIV(SLOWER_CLOCK_DIV), #SLOWEST_CLOCK_DIV(SLOWEST_CLOCK_DIV))
        }

    }
    // instantiate bin_to_dec module
    bin_to_dec bin_to_dec_converter(#DIGITS(4))
    always {
        // input raw inverted reset signal
        reset_cond.in = ~rst_n 
        // conditioned reset
        rst = reset_cond.out   
        // loop serial port
        usb_tx = usb_rx        
        // turn LEDs off
        led = 8h00             
        // turn io LEDs off
        io_led = 3x{{8h00}}    
        // turn segments off
        io_segment = 8hff        
        // select no digits  
        io_select = 4hf           
        // to reduce the bouncing effects of buttons p1, p2, p3, p4 to left, middle, right, top button respectively 
        btn_cond_p1.in = io_button[3]  
        btn_cond_p2.in = io_button[2]
        btn_cond_p3.in = io_dip[0][0]
        btn_cond_p4.in = io_dip[0][1]
        // get the edge of button press for buttons p1, p2, p3, p4
        edge_dt_btn_p1.in = btn_cond_p1.out 
        edge_dt_btn_p2.in = btn_cond_p2.out
        edge_dt_btn_p3.in = btn_cond_p3.out
        edge_dt_btn_p4.in = btn_cond_p4.out
        // send button output to game datapth
        game_datapath.p1_button = edge_dt_btn_p1.out
        game_datapath.p2_button = edge_dt_btn_p2.out
        game_datapath.p3_button = edge_dt_btn_p3.out
        game_datapath.p4_button = edge_dt_btn_p4.out
        // update 7segments
        // default to all 0 first
        seg.values = 4x{{4b0}} 
        // show score on seven segment displays
        bin_to_dec_converter.value = game_datapath.score_out
        // convert binary to decimal for seven segment display
        seg.values = bin_to_dec_converter.digits
        // show obstacles on top row, row 1
        io_led[0][0] = game_datapath.row1_out[8]
        io_led[0][2] = game_datapath.row1_out[7]
        io_led[0][4] = game_datapath.row1_out[6]
        io_led[0][6] = game_datapath.row1_out[5]
        io_led[1][0] = game_datapath.row1_out[4]
        io_led[1][2] = game_datapath.row1_out[2]
        io_led[1][4] = game_datapath.row1_out[1]
        // show obstacles on row 2
        io_led[0][1] = game_datapath.row2_out[8]
        io_led[0][3] = game_datapath.row2_out[7]
        io_led[0][5] = game_datapath.row2_out[6]
        io_led[0][7] = game_datapath.row2_out[5]
        io_led[1][1] = game_datapath.row2_out[4]
        io_led[1][3] = game_datapath.row2_out[2]
        io_led[1][5] = game_datapath.row2_out[1]
        // show obstacles on row 3
        led[4] = game_datapath.row3_out[8]
        led[5] = game_datapath.row3_out[7]
        led[6] = game_datapath.row3_out[6]
        led[7] = game_datapath.row3_out[5]
        led[3] = game_datapath.row3_out[4]
        led[2] = game_datapath.row3_out[2]
        led[1] = game_datapath.row3_out[1]
        // show player
        io_led[1][6] = game_datapath.orplayer_out[8]
        io_led[2][0] = game_datapath.orplayer_out[7]
        io_led[2][2] = game_datapath.orplayer_out[6]
        io_led[2][4] = game_datapath.orplayer_out[5]
        io_led[2][6] = game_datapath.orplayer_out[4]
        io_led[1][7] = game_datapath.orplayer_out[3]
        io_led[2][1] = game_datapath.orplayer_out[2]
        io_led[2][3] = game_datapath.orplayer_out[1]
        io_led[2][5] = game_datapath.orplayer_out[0]
        //io_led[2][7:5] = game_datapath.row1_out[8:6]
        //io_led[2][4:3] = game_datapath.row1_out[5:4]
        //io_led[2][2:1] = game_datapath.row1_out[2:1]
        //io_led[1][7:5] = game_datapath.row2_out[8:6]
        //io_led[1][4:3] = game_datapath.row2_out[5:4]
        //io_led[1][2:1] = game_datapath.row2_out[2:1]
        //io_led[0][7:5] = game_datapath.row3_out[8:6]
        //io_led[0][4:3] = game_datapath.row3_out[5:4]
        //io_led[0][2:1] = game_datapath.row3_out[2:1]
        //io_led[0][0] = game_datapath.orplayer_out[8]
        //led = game_datapath.orplayer_out[7:0]
        //io_led[2][0] = game_datapath.temp7_out[0]
        // show availability of power-up
        led[0] = game_datapath.temp7_out[0]
        // for seven segment display
        io_segment = ~seg.seg
        //io_select = ~seg.sel   
        io_select = seg.sel 
    }
}