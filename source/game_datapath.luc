module game_datapath#(
    // 0.5s clock div
    SLOW_CLOCK_DIV ~ 25 : SLOW_CLOCK_DIV > 0,
    // 1s clock div
    SLOWER_CLOCK_DIV ~ 26 : SLOWER_CLOCK_DIV > 0,
    //2s clock div
    SLOWEST_CLOCK_DIV ~ 27 : SLOWEST_CLOCK_DIV > 0
)(
    // button inputs
    input p1_button,
    input p2_button,
    input p3_button,
    input p4_button,
    // clock
    input clk,  
    // reset
    input rst,  
    // output to LEDs/7segments
    output score_out[32],
    output row1_out[32],
    output row2_out[32],
    output row3_out[32],
    output temp7_out[32],
    output orplayer_out[32],
    output slow_clock_out,
    output slow_clockx1_out,
    output slow_clockx2_out
) {
    // temp variables
    sig input_alu_a[32]
    sig input_alu_b[32]
    // instantiation of alu module
    alu game_alu
    .clk(clk){
        // 1s, 2s, 4s clocks with counter module
        counter game_timer_clock(#SIZE(1),#DIV(SLOW_CLOCK_DIV), .rst(rst)) 
        counter game_timer_clockx1(#SIZE(1),#DIV(SLOW_CLOCK_DIV), .rst(rst))
        counter game_timer_clockx2(#SIZE(1),#DIV(SLOWER_CLOCK_DIV), .rst(rst))
        // edge detector declaration & connection with counters to provide 1s, 2s, 4s delay
        edge_detector edge_detector_game_timer(#RISE(1), #FALL(0), .in(game_timer_clock.value))
        edge_detector edge_detector_game_timerx1(#RISE(1), #FALL(0), .in(game_timer_clockx1.value))
        edge_detector edge_detector_game_timerx2(#RISE(1), #FALL(0), .in(game_timer_clockx2.value))
        // instantiation of game_cu module
        game_cu game_cu(
            #SLOWER_CLOCK_DIV(SLOWER_CLOCK_DIV),
            #SLOWEST_CLOCK_DIV(SLOWEST_CLOCK_DIV),
            .p1_button(p1_button),
            .p2_button(p2_button),
            .p3_button(p3_button),
            .p4_button(p4_button),
            .rst(rst),
            .increase_timer(edge_detector_game_timer.out),
            .increase_timerx1(edge_detector_game_timerx1.out),
            .increase_timerx2(edge_detector_game_timerx2.out)
        )
        // instantiation of game_regfiles module
        game_regfiles game_regfiles(
            .we(game_cu.regfile_we), 
            .wa(game_cu.regfile_wa), 
            .ra1(game_cu.regfile_ra1), 
            .ra2(game_cu.regfile_ra2),
            .rst(rst)
        )
    }
    always {
        // bootstrap rd2 output to CU for convenient branching conditions
        game_cu.regfile_rd2 = game_regfiles.rd2
        // asel mux
        case(game_cu.asel){
            b0000  : input_alu_a = game_regfiles.rd1
            b0001  : input_alu_a = 10
            b0011  : input_alu_a = 2 
            b0010  : input_alu_a = 0
            b0100  : input_alu_a = 16
            b0101  : input_alu_a = 511
            b0111  : input_alu_a = 9999
            b1000  : input_alu_a = 191
            b1001  : input_alu_a = 255
            b1010  : input_alu_a = 383
            b1011  : input_alu_a = 447
            b1100  : input_alu_a = 471
            b1101  : input_alu_a = 495
            b1110  : input_alu_a = 506
            b1111  : input_alu_a = 509
            default : //necessary to init
                input_alu_a = 0
        }
        // bsel mux
        case(game_cu.bsel){
            b0000 : input_alu_b = game_regfiles.rd2
            b0001 : input_alu_b = 1
            b0011 : input_alu_b = 3
            b0010 : input_alu_b = 8
            b0100 : input_alu_b = 32
            b0101 : input_alu_b = 256
            b1000 : input_alu_b = 471
            b1001 : input_alu_b = 506
            b1010 : input_alu_b = 191
            b1011 : input_alu_b = 493
            b1100 : input_alu_b = 253
            b1101 : input_alu_b = 367
            b1110 : input_alu_b = 255
            b1111 : input_alu_b = 509
            default: //necessary to init
                input_alu_b = 0    
        }
        // alu
        game_alu.a = input_alu_a
        game_alu.b = input_alu_b
        game_alu.alufn_signal = game_cu.alufn
        // wdsel mux
        case (game_cu.alu_out_sel){
            b01 : game_regfiles.data = 0
            default : 
                game_regfiles.data = game_alu.out
        }
        // feed output to game_regfiles to show on FPGA
        score_out = game_regfiles.score_out
        row1_out = game_regfiles.row1_out
        row2_out = game_regfiles.row2_out
        row3_out = game_regfiles.row3_out
        temp7_out = game_regfiles.temp7_out
        orplayer_out = game_regfiles.orplayer_out
        slow_clock_out = game_timer_clock.value
        slow_clockx1_out = game_timer_clockx1.value
        slow_clockx2_out = game_timer_clockx2.value   
    }
}